@model IEnumerable<SalesManagement.Models.Department>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="page-heading">

    <h1>
        Departamentos
    </h1>

    <a
        class="btn btn-primary"
        asp-action="Create"
    >
        Novo departamento
    </a>

</div>

<div class="content-panel">

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nenhum departamento foi cadastrado.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th>Identificador</th>
                        <th>Nome</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var department in Model)
                    {
                        <tr>

                            <td>
                                @department.Id
                            </td>

                            <td>
                                @department.Name
                            </td>

                            <td class="table-actions">

                                <a
                                    class="btn btn-info btn-sm"
                                    asp-action="Details"
                                    asp-route-id="@department.Id"
                                >
                                    Detalhes
                                </a>

                                <a
                                    class="btn btn-default btn-sm"
                                    asp-action="Edit"
                                    asp-route-id="@department.Id"
                                >
                                    Editar
                                </a>

                                <a
                                    class="btn btn-danger btn-sm"
                                    asp-action="Delete"
                                    asp-route-id="@department.Id"
                                >
                                    Excluir
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>