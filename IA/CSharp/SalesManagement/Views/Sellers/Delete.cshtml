@model SalesManagement.Models.Seller

@{
    ViewData["Title"] = "Excluir vendedor";
}

<section class="form-panel">

    <h1 class="page-title">
        Excluir vendedor
    </h1>

    @if (ViewData["DeleteError"] != null)
    {
        <div class="alert alert-danger">
            @ViewData["DeleteError"]
        </div>
    }

    <div class="alert alert-warning">

        Confirme a exclusão deste vendedor.

        Vendedores com registros de venda associados
        não podem ser excluídos.

    </div>

    <dl class="dl-horizontal">

        <dt>
            Identificador
        </dt>

        <dd>
            @Model.Id
        </dd>

        <dt>
            Nome
        </dt>

        <dd>
            @Model.Name
        </dd>

        <dt>
            E-mail
        </dt>

        <dd>
            @Model.Email
        </dd>

        <dt>
            Departamento
        </dt>

        <dd>
            @Model.Department.Name
        </dd>

    </dl>

    <form
        method="post"
        action="@Url.Action("Delete", "Sellers", new { id = Model.Id })"
    >

        @Html.AntiForgeryToken()

        <input
            type="hidden"
            name="id"
            value="@Model.Id"
        />

        <div class="form-actions">

            <button
                type="submit"
                class="btn btn-danger"
            >
                Confirmar exclusão
            </button>

            <a
                class="btn btn-default"
                asp-action="Index"
            >
                Cancelar
            </a>

        </div>

    </form>

</section>