@model SalesManagement.Models.Seller

@{
    ViewData["Title"] = "Editar vendedor";
}

<section class="form-panel">

    <h1 class="page-title">
        Editar vendedor
    </h1>

    <form
        method="post"
        action="@Url.Action("Edit", "Sellers", new { id = Model.Id })"
    >

        @Html.AntiForgeryToken()

        <input
            type="hidden"
            asp-for="Id"
        />

        @Html.Partial("_Form", Model)

        <div class="form-actions">

            <button
                type="submit"
                class="btn btn-primary"
            >
                Salvar alterações
            </button>

            <a
                class="btn btn-default"
                asp-action="Index"
            >
                Cancelar
            </a>

        </div>

    </form>

</section>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}