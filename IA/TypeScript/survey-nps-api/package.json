{
  "name": "survey-nps-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de pesquisas de satisfacao e Net Promoter Score",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
